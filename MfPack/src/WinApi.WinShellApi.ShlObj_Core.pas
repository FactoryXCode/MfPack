{$WARN SYMBOL_PLATFORM ON}

  // Implement Additional Prototypes here.

function VOID_OFFSET(pv: Pointer;
                     cb: UINT): Pointer;
begin

  Result := Pointer(NativeUInt(pv) + cb);
end;


function ILSkip(pidl: PUIDLIST_RELATIVE;
                cb: UINT): PUIDLIST_RELATIVE;
begin

  Result := PUIDLIST_RELATIVE(VOID_OFFSET(pidl,
                                          cb));
end;

function ILNext(pidl: PUIDLIST_RELATIVE): PUIDLIST_RELATIVE;
begin

  Result := ILSkip(pidl,
                   pidl.mkid.cb);
end;


function ILIsAligned(pidl: PCUIDLIST_RELATIVE): BOOL;
begin

  Result := BOOL(Ord((NativeUInt(pidl) and (SizeOf(Pointer) - 1)) = 0));
end;


function ILIsEmpty(pidl: PCUIDLIST_RELATIVE): BOOL;
begin

  Result := BOOL(Ord((pidl = nil) or
                     (pidl.mkid.cb = 0)));
end;


function ILIsChild(pidl: PCUIDLIST_RELATIVE): BOOL;
begin

  Result := BOOL(Ord(Boolean(ILIsEmpty(pidl)) or
                     Boolean(ILIsEmpty(PCUIDLIST_RELATIVE(ILNext(PUIDLIST_RELATIVE(pidl)))))));
end;


function IDListContainerIsConsistent(pidl: PCUIDLIST_RELATIVE;
                                     cbAlloc: UINT): BOOL;
var
  cbPidl: UINT;

begin

  cbPidl := SizeOf(pidl.mkid.cb);

  while (cbPidl <= cbAlloc) and
        (pidl.mkid.cb >= SizeOf(pidl.mkid.cb)) and
        (pidl.mkid.cb <= cbAlloc - cbPidl) do
    begin
      Inc(cbPidl,
          pidl.mkid.cb);

      pidl := PCUIDLIST_RELATIVE(ILNext(PUIDLIST_RELATIVE(pidl)));
    end;

  Result := BOOL(Ord((cbPidl <= cbAlloc) and
                     (pidl.mkid.cb = 0)));
end;


function ILCloneFull(pidl: PCUIDLIST_ABSOLUTE): PIDLIST_ABSOLUTE;
begin

  Result := PIDLIST_ABSOLUTE(ILClone(PCUIDLIST_RELATIVE(pidl)));
end;


function ILCloneChild(pidl: PCUITEMID_CHILD): PITEMID_CHILD;
begin

  Result := ILCloneFirst(PCUIDLIST_RELATIVE(pidl));
end;

// Bitshifting helpers ---------------------------------------------------------

function GetDWordBits(const Bits: DWORD;
                      const aIndex: Integer): Integer;
begin

  Result := (Bits shr (aIndex shr 8))
            and ((1 shl Byte(aIndex)) - 1);
end;


procedure SetDWordBits(var Bits: DWORD;
                       const aIndex: Integer;
                       const aValue: Integer);
var
  Offset: Byte;
  Mask: Integer;

begin

  Mask := ((1 shl Byte(aIndex)) - 1);
  Assert(aValue <= Mask);

  Offset := aIndex shr 8;
  Bits := (Bits and (not (Mask shl Offset)))
          or DWORD(aValue shl Offset);
end;


// CABINETSTATE_FLAGS
function CABINETSTATE_BITS.GetBits(const aIndex: Integer): Integer;
begin

  Result := GetDWordBits(Flags,
                         aIndex);
end;


procedure CABINETSTATE_BITS.SetBits(const aIndex: Integer;
                                    const aValue: Integer);
begin

  SetDWordBits(Flags,
               aIndex,
               aValue);
end;


