package MfComponents;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'MfComponents for Delphi'}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  DesignIDE,
  MfPackX400;

contains
  QueueTimer in 'QueueTimer.pas',
  ThreadedQueueTimer in 'ThreadedQueueTimer.pas',
  MfPeakMeterEx in 'MfPeakMeterEx.pas',
  MfPeakMeter in 'MfPeakMeter.pas',
  MfPeakMeterMmcs in 'MfPeakMeterMmcs.pas',
  MfAudioVisualizer in 'MfAudioVisualizer.pas',
  MfAudioMixVisualizer in 'MfAudioMixVisualizer.pas',
  PcmLib in 'PcmLib.pas',
  MfAudioEffectMFTBase in 'MfAudioEffectMFTBase.pas',
  MfParametricEqMFT in 'MfParametricEqMFT.pas',
  MfFlangerEchoMFT in 'MfFlangerEchoMFT.pas',
  MfWasApiFxIntf in 'MfWasApiFxIntf.pas',
  MfWasApiFxComponentBase in 'MfWasApiFxComponentBase.pas',
  MfFxEditors in 'MfFxEditors.pas',
  MfFlangerEchoComponent in 'MfFlangerEchoComponent.pas',
  MfParametricEqComponent in 'MfParametricEqComponent.pas',
  MfCompressorLimiterMFT in 'MfCompressorLimiterMFT.pas',
  MfCompressorLimiterComponent in 'MfCompressorLimiterComponent.pas',
  MfChorusComponent in 'MfChorusComponent.pas',
  MfChorusMFT in 'MfChorusMFT.pas',
  MfLowMidHighEqComponent in 'MfLowMidHighEqComponent.pas',
  MfLowMidHighEqMFT in 'MfLowMidHighEqMFT.pas',
  MfAudioEndPoint in 'MfAudioEndPoint.pas',
  MfWasApiPlayerEngineComponent in 'MfWasApiPlayerEngineComponent.pas',
  WASAPIEngine in 'WASAPIEngine.pas',
  MfWasApiEffectsRack in 'MfWasApiEffectsRack.pas';

end.

