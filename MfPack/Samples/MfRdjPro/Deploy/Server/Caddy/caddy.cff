# RDJ Pro managed LAN address: 192.168.1.227
factoryxradio.asuscomm.com, http://192.168.1.227 {

    log {
        output file C:\Caddy\cast-access.log {
            roll_keep 2
        }
        format json
    }

    root * C:\Caddy
    file_server

    handle /stream/* {
        root * C:\Caddy
        header Cache-Control "no-store"
        header Access-Control-Allow-Origin "*"
        @hls path *.m3u8
        header @hls Content-Type "application/vnd.apple.mpegurl"
        @fmp4 path *.m4s *.mp4
        header @fmp4 Content-Type "video/mp4"
        file_server
    }

    handle /live* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /status* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /admin* {
        respond "Forbidden" 403
    }
}
