factoryxradio.asuscomm.com {

    root * C:\Caddy

    handle /admin* {
        respond "Forbidden" 403
    }

    handle /admin.xsl* {
        respond "Forbidden" 403
    }

    handle /live* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
            transport http {
                read_timeout 0
                write_timeout 0
                dial_timeout 10s
            }
        }
    }

    handle /video.mjpg* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
            transport http {
                read_timeout 0
                write_timeout 0
                dial_timeout 10s
            }
        }
    }

    handle /status* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /video/* {
        root * C:\Caddy
        header Cache-Control "no-store"
        header Access-Control-Allow-Origin "*"
        file_server
    }

    handle /stream/* {
        root * C:\Caddy
        header Cache-Control "no-store"
        file_server
    }

    handle {
        file_server
    }
}
