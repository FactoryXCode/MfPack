factoryxradio.asuscomm.com {

    root * C:\Caddy

    log {
        output file C:\Caddy\Caddy.log {
            roll_keep 2
        }
        format json
    }

    handle /admin* {
        respond "Forbidden" 403
    }

    handle /admin.xsl* {
        respond "Forbidden" 403
    }

    handle /live* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
            transport http {
                read_timeout 0
                write_timeout 0
                dial_timeout 10s
            }
        }
    }

    handle /video.mjpg* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
            transport http {
                read_timeout 0
                write_timeout 0
                dial_timeout 10s
            }
        }
    }

    handle /status* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /video/* {
        root * C:\Caddy
        header Cache-Control "no-store"
        header Access-Control-Allow-Origin "*"
        file_server
    }

    handle /stream/* {
        root * C:\Caddy
        header Cache-Control "no-store"
        header Access-Control-Allow-Origin "*"
        @hls path *.m3u8
        header @hls Content-Type "application/vnd.apple.mpegurl"
        @fmp4 path *.m4s *.mp4
        header @fmp4 Content-Type "video/mp4"
        file_server
    }

    handle {
        file_server
    }
}
